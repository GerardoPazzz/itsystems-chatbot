# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
PORT=3000

# ============================================
# CONFIGURACIÓN DE GEMINI (AI)
# ============================================
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_TOKENS=500
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_HISTORY=6

# ============================================
# CONFIGURACIÓN DE SAP (OData)
# ============================================
SAP_BASE_URL=https://tu-servidor-sap.com:443
SAP_ODATA_MAT_URL=https://tu-servidor-sap.com:443
SAP_USER=tu_usuario_sap
SAP_PASSWORD=tu_password_sap
SAP_CLIENT=300

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL)
# ============================================
DB_USER=tu_usuario_db
DB_PASSWORD=tu_password_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ag_itsystems

# ============================================
# CONFIGURACIÓN DE CORREO (Gmail)
# ============================================
# GMAIL_USER: cuenta de Gmail que envia las credenciales.
# GMAIL_APP_PASSWORD: contraseña de aplicación de Google (16 caracteres).
#   Se genera en https://myaccount.google.com/apppasswords (requiere 2FA activo).
#   NO es la contraseña normal de la cuenta.
# MAIL_FROM: nombre visible del remitente (opcional). Por defecto usa GMAIL_USER.
GMAIL_USER=tu_cuenta@gmail.com
GMAIL_APP_PASSWORD=tu_contrasena_de_aplicacion
MAIL_FROM=ITSYSTEMS <tu_cuenta@gmail.com>
